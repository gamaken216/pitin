// ピットイン Service Worker
// 方針: ページ(HTML)とJS/CSSは「network-first」で常に最新を取得し、
//       オフライン時のみキャッシュにフォールバック。
//       ダブルス組み合わせアプリはオフラインでも動くよう事前キャッシュ。
// ※ サイトを更新しても画面が変わらない問題を防ぐため、network-first にしています。
//   大きく作り替えたときは下の CACHE_NAME の数字を1つ上げてください（古いキャッシュが消えます）。
const CACHE_NAME = 'pitin-v3';
const ASSETS = [
  '/pitin/tennis-doubles_ver3.html',
  '/pitin/manifest.json'
];

// インストール: アプリ本体を事前キャッシュ
self.addEventListener('install', event => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(cache => cache.addAll(ASSETS))
  );
  self.skipWaiting();
});

// 有効化: 古いバージョンのキャッシュを全部削除
self.addEventListener('activate', event => {
  event.waitUntil(
    caches.keys().then(keys =>
      Promise.all(keys.filter(k => k !== CACHE_NAME).map(k => caches.delete(k)))
    )
  );
  self.clients.claim();
});

// 取得: network-first（最新を優先、ダメならキャッシュ）
self.addEventListener('fetch', event => {
  const req = event.request;
  // GET以外（POST等）はそのまま通す
  if (req.method !== 'GET') return;

  event.respondWith(
    fetch(req)
      .then(res => {
        // 取得できたら最新版をキャッシュに保存（同一オリジンのみ）
        if (res && res.ok && req.url.startsWith(self.location.origin)) {
          const copy = res.clone();
          caches.open(CACHE_NAME).then(cache => cache.put(req, copy));
        }
        return res;
      })
      .catch(() => caches.match(req)) // オフライン等で失敗したらキャッシュを返す
  );
});
